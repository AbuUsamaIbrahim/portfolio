---
import Layout from '../layouts/Layout.astro';

/* ------------------------------------------------------------------
   Fill PHONE in before sending this to anyone. Left blank = omitted,
   which is safer than shipping a placeholder into a PDF.
------------------------------------------------------------------ */
const PHONE = '+880 1833 183667';

/* Two deliberate lines rather than one long one.
   Joined into a single string, these five items overflow the A4 text column and
   wrap wherever the line happens to run out — usually mid-URL, which is the one
   place a break is unreadable. Splitting them by kind (where to reach him / where
   to read more) puts the break where it was chosen rather than where it landed. */
const CONTACT_REACH = [
  'Dhaka, Bangladesh',
  { text: 'mahadihasan.parash@gmail.com', href: 'mailto:mahadihasan.parash@gmail.com' },
  { text: PHONE, href: `tel:${PHONE.replace(/\s/g, '')}` },
].filter(Boolean);

const CONTACT_LINKS = [
  { text: 'linkedin.com/in/mahadihasan-parash', href: 'https://linkedin.com/in/mahadihasan-parash' },
  { text: 'mahadi-hasan.pages.dev', href: 'https://mahadi-hasan.pages.dev' },
];

const SUMMARY = `Lead Software Engineer with 8+ years building event-driven backend systems for telecom billing, mobile financial services and utility platforms. Currently leading a team of 4 engineers on an invoice pipeline generating approximately 2 million customer invoices per billing cycle. Java, Kotlin, Spring Boot, Apache Kafka, microservices and Kubernetes, with a track record of distributed systems where correctness and auditability are non-negotiable, across core banking integration, payment platforms, API security and large-scale ERP.`;

const SKILLS = [
  { g: 'Languages', v: 'Java (8/17/21), Kotlin, Groovy, JavaScript, TypeScript, SQL, PL/SQL' },
  { g: 'Frameworks', v: 'Spring Boot, Spring Batch, Spring Security, Spring Data JPA, Spring Cloud Gateway, Spring WebFlux, Hibernate, Grails, React.js' },
  { g: 'Distributed Systems', v: 'Apache Kafka, RabbitMQ, Event-Driven Architecture, Microservices, REST APIs, Reactive Programming, ShedLock, Idempotency, Backpressure' },
  { g: 'Databases', v: 'Oracle, PostgreSQL, MS SQL Server, MySQL, ClickHouse, Redis, Flyway, Liquibase' },
  { g: 'Cloud & DevOps', v: 'Docker, Kubernetes, Helm, ArgoCD, GitLab CI/CD, SonarQube, Harbor, Git, Linux' },
  { g: 'Security', v: 'OAuth2, JWT, HMAC, ECDH Key Exchange, AES-GCM, Spring Security, Azure AD' },
  { g: 'Fintech & Domain', v: 'Apache Fineract, Cyclos, Core Banking (CBS), Double-Entry Ledger, ISO 8583, Telecom Billing (BSS), KYC, Mobile Financial Services (MFS)' },
  { g: 'Practices', v: 'Microservice Design, System Design, Distributed Systems, Code Review, Technical Leadership, Mentoring, Agile' },
];

const EXPERIENCE = [
  {
    title: 'Lead Software Engineer',
    org: 'Robi Axiata PLC.',
    loc: 'Dhaka, Bangladesh',
    dates: 'Jun 2026 – Present',
    bullets: [
      'Lead backend engineering across two enterprise platforms: postpaid billing and invoicing, and a nationwide sales and distribution (SFA) platform.',
      'Lead a team of 4 engineers delivering an event-driven invoice pipeline that generates approximately 2 million customer invoices per billing cycle.',
      'Own release integration for a 14-module Java 21 / Spring Boot monorepo, stabilising the development line into staging and clearing SonarQube quality-gate and container-registry issues across GitLab CI pipelines deploying via Helm and ArgoCD to Kubernetes.',
      'Extended corporate billing to support parent/child account hierarchies, bulk PDF generation and automated mail reconciliation for delivery verification.',
      'Delivered SFA features spanning retailer stock, electronic load, cash-in-hand ledger, incentives and geospatial territory mapping using Hibernate Spatial and JTS.',
    ],
  },
  {
    title: 'Lead Software Engineer',
    org: 'RedDot Digital Limited',
    loc: 'Dhaka, Bangladesh',
    dates: 'Sep 2024 – Jun 2026',
    bullets: [
      'Primary author of the core services of a postpaid billing platform: XML billing parser, charging service and reporting service.',
      'Architected an event-driven invoice pipeline — Spring Batch XML parsing, Apache Kafka transport, PDF generation and email notification over Redis handoff and Oracle persistence — made reliable with timeout backstops, stalled-producer detection and explicit backpressure, eliminating silent stalls in the billing cycle.',
      'Published a shared Java contract library standardising Kafka topics, compression and DTOs across 6 microservices, turning integration drift into compile-time errors; designed the data layer across Oracle, PostgreSQL and ClickHouse with versioned migrations and ShedLock-coordinated scheduling.',
      'Delivered core banking and ledger features on a digital wallet platform integrated with Apache Fineract — general ledger statements, end-of-day CBS reporting, payment-type handling and transaction reversal via compensating entries — as repository maintainer on the wallet core and portal repositories.',
      'Built a reactive API gateway from scratch with Spring Cloud Gateway and WebFlux using ECDH key exchange, AES-GCM payload encryption, HMAC request signing and JWT validation, alongside biometric KYC services: fingerprint matching (SourceAFIS), national ID OCR and face-match APIs.',
      'Built retailer-facing MFS features in Kotlin and Java — digital memo with PDF generation, stock APIs, electronic load, campaign commissions, direct recharge with barred-customer validation — plus an operations portal with a React front end on Spring Security / Azure AD OAuth2; mentored and reviewed code for a team of 4.',
    ],
  },
  {
    title: 'Senior Software Engineer',
    org: 'RedDot Digital Limited',
    loc: 'Dhaka, Bangladesh',
    dates: 'Oct 2022 – Sep 2024',
    bullets: [
      'Built backend services for a mobile financial services (MFS) platform spanning its core ledger, REST API layer and merchant-facing portals, implementing ledger operations on a Cyclos-based mobile banking core over PostgreSQL for customer, agent, distributor and merchant wallets, with agent-banking APIs covering DSR/DO transactions, transaction-limit validation and distributor commission disbursement.',
      'Delivered open-portal and institutional payment flows with event-listener based processing, and an education payment management system with fee configuration, bulk student import with failure reporting and academic-year collection dashboards.',
      'Reviewed and merged pull requests across MFS and EPMS repositories, acting as release gatekeeper prior to formal promotion to Lead.',
    ],
  },
  {
    title: 'Programmer',
    org: 'IICT, BUET',
    loc: 'Dhaka, Bangladesh',
    dates: 'Jan 2022 – Sep 2022',
    bullets: [
      'Built and extended a Spring Boot REST API layer exposing a utility ERP to portal and mobile clients, using Spring Data JPA over Oracle, Spring Security with JWT authentication and Swagger-documented endpoints, and rolled out shared modules across three utility deployments covering reporting, dashboards, document management and SMS notifications.',
    ],
  },
  {
    title: 'Assistant Programmer',
    org: 'IICT, BUET',
    loc: 'Dhaka, Bangladesh',
    dates: 'Feb 2019 – Jan 2022',
    bullets: [
      'Developed the customer billing and revenue ERP used by three state-owned gas distribution companies, comprising approximately 90 controllers across 15 modules.',
      'Built core modules in Grails and Groovy covering customer management, metering, billing and revenue, demand notes, bank collections, prepaid transactions and the full connection lifecycle: load change, ownership transfer, meter change, disconnection, reconnection and zone migration.',
      'Developed vigilance and legal modules for unauthorised-use cases and litigation tracking, and built operational and financial reporting with Jasper Reports over Oracle using PL/SQL stored procedures.',
    ],
  },
  {
    title: 'Junior Executive, IT',
    org: 'Sundarban Courier Service Pvt. Ltd.',
    loc: 'Dhaka, Bangladesh',
    dates: 'Jul 2018 – Jan 2019',
    bullets: [
      'Supported and extended internal IT systems for a nationwide courier network, including REST web service integration.',
    ],
  },
];

const CERTS = [
  'Claude Code: Software Engineering with Generative AI Agents — Vanderbilt University (Jun 2026)',
  'AI Fundamentals, Collaboration and Automation with Claude — Advancing Women in Tech (Jun 2026)',
  'Spring Boot Microservices: Extending, Securing, Dockerizing — LinkedIn Learning (2022)',
  'Problem Solving Techniques — LinkedIn Learning (2022)',
  'LICT TOP UP-IT JAVA — NASSCOM IT-ITES Sector Skill Council (Apr 2017)',
];
---

<Layout
  title="Mahadi Hasan Parash — CV"
  description="Curriculum vitae of Mahadi Hasan Parash, Lead Software Engineer specialising in event-driven Java systems for telecom billing and fintech."
>
  <div class="mx-auto max-w-3xl px-5 pt-12 pb-6 print:max-w-none print:px-0 print:pt-0">
    {/* screen-only toolbar */}
    <div class="mb-10 flex flex-wrap items-center gap-3 print:hidden">
      <button
        id="print-cv"
        class="rounded-lg border border-[var(--color-flow)]/45 bg-[var(--color-flow)]/10 px-4 py-2.5 font-mono text-[12px] transition-colors hover:bg-[var(--color-flow)]/15"
      >
        Save as PDF ↓
      </button>
      {/* The reminder is here because the browser's stamp is outside the page and no
          stylesheet can reach it. Chrome prints the date, the tab title and the URL
          into the paper margin unless the box is unticked, and it remembers the
          choice — so this is a note you need once. */}
      <p class="font-mono text-[11px] leading-relaxed text-[var(--color-ink-faint)]">
        Prints single-column, black on white — parses cleanly in applicant tracking systems.<br />
        In the print dialog, untick <strong class="text-[var(--color-ink-dim)]">Headers and footers</strong>
        under “More settings”, or the browser stamps the date and URL onto the page.
      </p>
    </div>

    <article id="cv" class="cv">
      {/* ---------- HEADER ---------- */}
      <header class="cv-head">
        <h1>Mahadi Hasan Parash</h1>
        <p class="cv-role">Lead Software Engineer</p>
        {
          [CONTACT_REACH, CONTACT_LINKS].map((line) => (
            <p class="cv-contact">
              {line.map((item, i) => (
                <>
                  {/* real spaces around the bullet, not just CSS padding: a parser
                      reads the text, and "Bangladesh•name@gmail.com" is one token */}
                  {i > 0 && <span class="cv-sep">{' • '}</span>}
                  {/* nowrap so a break can only fall on a separator, never inside
                      an address or a URL */}
                  <span class="cv-contact-item">
                    {typeof item === 'string' ? item : <a href={item.href}>{item.text}</a>}
                  </span>
                </>
              ))}
            </p>
          ))
        }
      </header>

      {/* ---------- SUMMARY ---------- */}
      <section>
        <h2>Professional Summary</h2>
        <p>{SUMMARY}</p>
      </section>

      {/* ---------- SKILLS ---------- */}
      <section>
        <h2>Technical Skills</h2>
        {
          SKILLS.map((s) => (
            <p class="cv-skill">
              <strong>{s.g}:</strong> {s.v}
            </p>
          ))
        }
      </section>

      {/* ---------- EXPERIENCE ---------- */}
      <section>
        <h2>Professional Experience</h2>
        {
          EXPERIENCE.map((job) => (
            <div class="cv-job">
              <h3>{job.title}</h3>
              <p class="cv-meta">
                {job.org} — {job.loc} | {job.dates}
              </p>
              <ul>
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      {/* ---------- EDUCATION ---------- */}
      <section>
        <h2>Education</h2>
        <div class="cv-job">
          <h3>Bachelor of Science in Computer Science &amp; Engineering</h3>
          <p class="cv-meta">Jashore University of Science and Technology — Jashore, Bangladesh | 2013 – 2017</p>
        </div>
      </section>

      {/* ---------- CERTIFICATIONS ---------- */}
      <section>
        <h2>Certifications</h2>
        <ul>
          {CERTS.map((c) => <li>{c}</li>)}
        </ul>
      </section>
    </article>
  </div>
</Layout>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  /* ---------- shared structure ---------- */
  .cv h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .cv .cv-role {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--color-flow);
  }
  .cv .cv-contact {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-dim);
  }
  .cv .cv-contact + .cv-contact {
    margin-top: 0.2rem;
  }
  /* A break may fall on a separator, never inside an address or a URL. */
  .cv .cv-contact-item {
    white-space: nowrap;
  }
  .cv .cv-sep {
    padding: 0 0.5rem;
    opacity: 0.55;
  }
  .cv .cv-contact a {
    color: inherit;
    text-decoration: none;
  }
  .cv .cv-contact a:hover {
    color: var(--color-flow);
  }
  .cv-head {
    border-bottom: 2px solid var(--color-line-bright);
    padding-bottom: 0.9rem;
  }
  .cv section {
    margin-top: 1.6rem;
  }
  .cv h2 {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-flow);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.3rem;
    margin-bottom: 0.7rem;
  }
  .cv h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .cv .cv-meta {
    font-size: 0.85rem;
    color: var(--color-ink-dim);
    margin-top: 0.1rem;
  }
  .cv .cv-skill {
    font-size: 0.88rem;
    color: var(--color-ink-dim);
    margin-bottom: 0.35rem;
    line-height: 1.5;
  }
  .cv .cv-skill strong {
    color: var(--color-ink);
  }
  .cv p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-ink-dim);
  }
  .cv .cv-job {
    margin-bottom: 1.15rem;
  }
  .cv ul {
    margin-top: 0.45rem;
    padding-left: 1.1rem;
  }
  .cv li {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink-dim);
    margin-bottom: 0.3rem;
    list-style: disc;
  }

  /* ---------- ATS-safe print ---------- */
  @media print {
    @page {
      size: A4;
      /* 12mm top and bottom rather than 14mm. Still a generous, printable margin
         — and the two pages it buys are worth more than the whitespace. */
      margin: 13mm 15mm;
    }
    html,
    body {
      background: #fff !important;
      color: #000 !important;
    }
    body::before {
      display: none !important;
    }
    /* The site chrome goes; the CV's own masthead stays.
       `header` on its own also matches .cv-head — which is a <header> — so this
       rule was silently deleting the name, role and contact details from every
       printed copy. The page still looked fine on screen, and the PDF was a CV
       belonging to nobody. */
    header:not(.cv-head),
    footer,
    nav,
    .print\:hidden {
      display: none !important;
    }
    main {
      margin: 0 !important;
      padding: 0 !important;
    }
    .cv,
    .cv * {
      color: #000 !important;
      background: transparent !important;
      font-family: Georgia, "Times New Roman", serif;
    }
    .cv h1 {
      font-size: 21pt;
      letter-spacing: 0.01em;
      line-height: 1.05;
    }
    .cv .cv-role,
    .cv h2 {
      color: #000 !important;
    }
    .cv .cv-role {
      font-size: 10.5pt;
      letter-spacing: 0.16em;
      margin-top: 2.5pt;
    }
    /* The separator carries the eye across a line of unlike things; at full black
       it competes with them instead. */
    .cv .cv-sep {
      padding: 0 4.5pt;
      color: #666 !important;
    }
    .cv h2 {
      font-size: 10.5pt;
      border-bottom: 1px solid #000;
      margin-top: 8pt;
      margin-bottom: 4pt;
      padding-bottom: 2pt;
    }
    .cv h3 {
      font-size: 11pt;
    }
    .cv p,
    .cv li {
      font-size: 9.7pt;
      line-height: 1.34;
    }
    /* Print density. The screen rules are set in rem against a 16px root and
       carry far more air than paper needs — a 1.15rem gap under each role is
       ~14pt, six times over. None of this was overridden here, so the printed
       copy inherited screen spacing and ran to three pages. */
    .cv .cv-skill {
      font-size: 9.7pt;
      line-height: 1.34;
      margin-bottom: 2.5pt;
    }
    .cv ul {
      margin-top: 2.5pt;
      padding-left: 12pt;
    }
    .cv li {
      margin-bottom: 1.5pt;
    }
    .cv .cv-job {
      margin-bottom: 6.5pt;
    }
    .cv h3 {
      margin-top: 0;
    }
    .cv .cv-contact,
    .cv .cv-meta {
      font-size: 9.5pt;
    }
    .cv .cv-contact {
      margin-top: 5pt;
      color: #222 !important;
    }
    .cv .cv-contact + .cv-contact {
      margin-top: 1.5pt;
    }
    .cv-head {
      border-bottom: 1pt solid #000;
      padding-bottom: 8pt;
      margin-bottom: 2pt;
    }
    .cv section {
      margin-top: 6pt;
    }
    /* A role may split across a page; a role may not be stranded.
       `break-inside: avoid` reads as tidy and behaves badly here: the largest
       role runs about twenty lines, so it cannot fit in whatever is left of a
       page and is pushed whole to the next one — leaving a third of page one
       blank and costing a page overall. Orphans and widows buy the thing that
       was actually wanted: never a heading alone at the foot of a page, never a
       single trailing line at the head of the next. */
    .cv-job {
      orphans: 3;
      widows: 3;
    }
    .cv h2,
    .cv h3 {
      break-after: avoid;
      page-break-after: avoid;
    }
    a {
      text-decoration: none !important;
    }
  }
</style>
