---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.index - b.data.index
);

const principles = [
  {
    n: '01',
    title: 'Absence of an error is not evidence of progress',
    body: 'The worst production failure I have owned did not throw. A Kafka producer stalled silently and a billing run simply stopped. Anything that can hang needs a clock on it, so an invisible wedge becomes a loud, catchable failure.',
  },
  {
    n: '02',
    title: 'Model the lifecycle, not the current state',
    body: 'A boolean tells you where something is. It cannot tell you how it got there or who authorised it. In billing, ledgers and utility connections, that history is the part auditors, courts and customers actually ask about.',
  },
  {
    n: '03',
    title: 'Contracts belong in one place',
    body: 'Six services drifting apart on message shape is how an event-driven system rots quietly. One shared library owning topic names, encoding and DTOs turns a breaking change into a compile error instead of a 3am incident.',
  },
  {
    n: '04',
    title: 'Choose the boring tier deliberately',
    body: 'Reactive where the work is I/O and back-pressure is real. A monolith where one team shares one database. Complexity is a budget — spend it where the problem is, and be able to say why you did not spend it elsewhere.',
  },
];

const stack = [
  { group: 'Core', items: ['Java 21', 'Kotlin', 'Spring Boot 3.x', 'Spring Batch', 'Spring Security'] },
  { group: 'Distributed', items: ['Apache Kafka', 'RabbitMQ', 'Spring Cloud Gateway', 'WebFlux', 'ShedLock'] },
  { group: 'Data', items: ['Oracle', 'PostgreSQL', 'ClickHouse', 'Redis', 'Flyway', 'Liquibase'] },
  { group: 'Platform', items: ['Docker', 'Kubernetes', 'Helm', 'ArgoCD', 'GitLab CI', 'SonarQube'] },
  { group: 'Frontend', items: ['React', 'Ant Design', 'TypeScript'] },
];
---

<Layout>
  {/* ==================== HERO ==================== */}
  <section class="mx-auto max-w-5xl px-5 pt-20 pb-16 sm:pt-28 sm:pb-24">
    <p class="reveal font-mono text-[11px] tracking-[0.24em] text-[var(--color-flow)] uppercase">
      Lead Software Engineer · Robi Axiata
    </p>

    <h1 class="reveal mt-5 max-w-3xl text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-6xl">
      I build event-driven systems where
      <span class="relative inline-block">
        <span class="relative z-10">being wrong costs money.</span>
        <span class="absolute inset-x-0 bottom-0.5 -z-0 h-2 bg-[var(--color-flow)]/20"></span>
      </span>
    </h1>

    <p class="reveal mt-7 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-dim)]">
      Eight years on telecom billing, mobile financial services and utility platforms — the kind of
      software where a dropped message means someone is not billed, or is billed twice. Currently
      leading a team of four on a pipeline that generates around two million invoices per cycle.
    </p>

    <div class="reveal mt-9 flex flex-wrap items-center gap-3">
      <a
        href="#work"
        class="group inline-flex items-center gap-2 rounded-lg border border-[var(--color-flow)]/45 bg-[var(--color-flow)]/10 px-4 py-2.5 font-mono text-[12px] text-[var(--color-ink)] transition-all hover:border-[var(--color-flow)] hover:bg-[var(--color-flow)]/15"
      >
        Read the case studies
        <span class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
      <a
        href="https://www.linkedin.com/in/mahadihasan-parash/"
        class="rounded-lg border border-[var(--color-line-bright)] px-4 py-2.5 font-mono text-[12px] text-[var(--color-ink-dim)] transition-colors hover:border-[var(--color-ink-dim)] hover:text-[var(--color-ink)]"
      >
        LinkedIn ↗
      </a>
    </div>

    {/* stat strip */}
    <dl class="reveal mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-4">
      {
        [
          { v: '8+', l: 'years shipping' },
          { v: '~2M', l: 'invoices / cycle' },
          { v: '4', l: 'engineers led' },
          { v: '3', l: 'domains: telco, fintech, utility' },
        ].map((s) => (
          <div class="bg-[var(--color-base)] px-4 py-5">
            <dt class="font-mono text-2xl text-[var(--color-flow)]">{s.v}</dt>
            <dd class="mt-1 font-mono text-[10px] leading-snug text-[var(--color-ink-faint)]">{s.l}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ==================== WORK ==================== */}
  <section id="work" class="mx-auto max-w-5xl scroll-mt-20 px-5 py-16">
    <div class="reveal flex items-baseline gap-4">
      <h2 class="font-mono text-[12px] tracking-[0.22em] text-[var(--color-flow)] uppercase">Case Studies</h2>
      <span class="h-px flex-1 bg-gradient-to-r from-[var(--color-line-bright)] to-transparent"></span>
    </div>
    <p class="reveal mt-4 max-w-2xl text-[var(--color-ink-dim)]">
      Most of this work is under NDA, so there are no screenshots or repositories here. What there is
      instead: the architecture, the decisions, and the alternatives I turned down.
    </p>

    <ul class="mt-10 space-y-4">
      {
        studies.map((s) => (
          <li class="reveal">
            <a
              href={`/work/${s.id}/`}
              class="group relative block overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)]/60 p-6 transition-all duration-300 hover:border-[var(--color-line-bright)] hover:bg-[var(--color-surface)] sm:p-7"
            >
              <span
                class="absolute inset-y-0 left-0 w-px transition-all duration-300 group-hover:w-[3px]"
                style={`background:${s.data.accent}`}
              />
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="font-mono text-[11px]" style={`color:${s.data.accent}`}>
                  {String(s.data.index).padStart(2, '0')}
                </span>
                <h3 class="text-xl font-semibold tracking-tight text-[var(--color-ink)]">{s.data.title}</h3>
                <span class="font-mono text-[10px] text-[var(--color-ink-faint)]">{s.data.period}</span>
              </div>

              <p class="mt-1.5 font-mono text-[11px] text-[var(--color-ink-faint)]">{s.data.subtitle}</p>
              <p class="mt-4 max-w-2xl leading-relaxed text-[var(--color-ink-dim)]">{s.data.summary}</p>

              <div class="mt-5 flex flex-wrap items-center gap-1.5">
                {s.data.stack.slice(0, 6).map((t) => (
                  <span class="rounded border border-[var(--color-line)] bg-[var(--color-base)] px-2 py-1 font-mono text-[10px] text-[var(--color-ink-faint)]">
                    {t}
                  </span>
                ))}
                {s.data.stack.length > 6 && (
                  <span class="font-mono text-[10px] text-[var(--color-ink-faint)]">
                    +{s.data.stack.length - 6}
                  </span>
                )}
              </div>

              <span class="mt-5 inline-flex items-center gap-2 font-mono text-[11px] text-[var(--color-ink-dim)] transition-colors group-hover:text-[var(--color-ink)]">
                Read the breakdown
                <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ==================== APPROACH ==================== */}
  <section id="approach" class="mx-auto max-w-5xl scroll-mt-20 px-5 py-16">
    <div class="reveal flex items-baseline gap-4">
      <h2 class="font-mono text-[12px] tracking-[0.22em] text-[var(--color-flow)] uppercase">How I Work</h2>
      <span class="h-px flex-1 bg-gradient-to-r from-[var(--color-line-bright)] to-transparent"></span>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        principles.map((p) => (
          <article class="reveal rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)]/40 p-6">
            <span class="font-mono text-[11px] text-[var(--color-flow-deep)]">{p.n}</span>
            <h3 class="mt-3 text-lg leading-snug font-semibold text-[var(--color-ink)]">{p.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-ink-dim)]">{p.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ==================== STACK ==================== */}
  <section id="stack" class="mx-auto max-w-5xl scroll-mt-20 px-5 py-16">
    <div class="reveal flex items-baseline gap-4">
      <h2 class="font-mono text-[12px] tracking-[0.22em] text-[var(--color-flow)] uppercase">Stack</h2>
      <span class="h-px flex-1 bg-gradient-to-r from-[var(--color-line-bright)] to-transparent"></span>
    </div>
    <p class="reveal mt-4 max-w-2xl text-[var(--color-ink-dim)]">
      Things I have shipped and operated in production — not a list of everything I have read about.
    </p>

    <dl class="mt-9 space-y-5">
      {
        stack.map((row) => (
          <div class="reveal grid gap-3 border-t border-[var(--color-line)] pt-5 sm:grid-cols-[130px_1fr]">
            <dt class="font-mono text-[11px] tracking-[0.14em] text-[var(--color-ink-faint)] uppercase">
              {row.group}
            </dt>
            <dd class="flex flex-wrap gap-1.5">
              {row.items.map((i) => (
                <span class="rounded-md border border-[var(--color-line)] bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[11px] text-[var(--color-ink-dim)]">
                  {i}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ==================== CONTACT ==================== */}
  <section id="contact" class="mx-auto max-w-5xl scroll-mt-20 px-5 py-16">
    <div
      class="reveal relative overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)]/50 p-8 sm:p-12"
    >
      <div
        class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-[var(--color-flow)]/10 blur-3xl"
      >
      </div>
      <h2 class="max-w-xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
        Happy to talk about backend architecture, event-driven systems, and telecom or fintech platforms.
      </h2>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="https://www.linkedin.com/in/mahadihasan-parash/"
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-flow)]/45 bg-[var(--color-flow)]/10 px-4 py-2.5 font-mono text-[12px] transition-colors hover:bg-[var(--color-flow)]/15"
        >
          LinkedIn ↗
        </a>
        <a
          href="https://github.com/AbuUsamaIbrahim"
          class="rounded-lg border border-[var(--color-line-bright)] px-4 py-2.5 font-mono text-[12px] text-[var(--color-ink-dim)] transition-colors hover:text-[var(--color-ink)]"
        >
          GitHub ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
