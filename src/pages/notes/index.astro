---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const notes = (await getCollection('field-notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// UTC, because the dateline is part of the record. A note written on the 30th should not
// render as the 29th because a reader's browser sits west of the author.
const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

const LAB_REPO = 'https://github.com/AbuUsamaIbrahim/k8s-lab';
---

<Layout
  title="Field Notes — Mahadi Hasan"
  description="Proof-driven notes from an ongoing Kubernetes lab: what I broke, and what the output actually said."
>
  <section class="mx-auto max-w-5xl px-5 pt-20 pb-16 sm:pt-24">
    <p class="reveal font-mono text-[11px] tracking-[0.24em] text-[var(--color-signal)] uppercase">
      Ongoing series
    </p>

    <h1 class="reveal mt-5 max-w-3xl text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">
      Field notes — what I broke, and what the output
      <span class="relative inline-block">
        <span class="relative z-10">actually said.</span>
        <span class="absolute inset-x-0 bottom-0.5 -z-0 h-2 bg-[var(--color-signal)]/20"></span>
      </span>
    </h1>

    <p class="reveal mt-7 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-dim)]">
      The case studies are systems I have already shipped. This is the opposite end: an ongoing
      Kubernetes lab, written up while it is still in progress. Every claim here is backed by
      terminal output from a cluster on my laptop — if I could not reproduce it, it is not in the
      note.
    </p>

    <div class="reveal mt-9 flex flex-wrap items-center gap-3">
      <a
        href={LAB_REPO}
        class="rounded-lg border border-[var(--color-line-bright)] px-4 py-2.5 font-mono text-[12px] text-[var(--color-ink-dim)] transition-colors hover:border-[var(--color-ink-dim)] hover:text-[var(--color-ink)]"
      >
        The lab repo ↗
      </a>
      <a
        href="/#work"
        class="rounded-lg border border-[var(--color-line-bright)] px-4 py-2.5 font-mono text-[12px] text-[var(--color-ink-dim)] transition-colors hover:border-[var(--color-ink-dim)] hover:text-[var(--color-ink)]"
      >
        Case studies →
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-16">
    <div class="reveal flex items-baseline gap-4">
      <h2 class="font-mono text-[12px] tracking-[0.22em] text-[var(--color-signal)] uppercase">
        Notes
      </h2>
      <span class="h-px flex-1 bg-gradient-to-r from-[var(--color-line-bright)] to-transparent"></span>
    </div>

    {
      notes.length === 0 ? (
        <p class="reveal mt-8 font-mono text-[12px] text-[var(--color-ink-faint)]">
          Nothing published yet.
        </p>
      ) : (
        <ul class="mt-10 space-y-4">
          {notes.map((n) => (
            <li class="reveal">
              <a
                href={`/notes/${n.id}/`}
                data-umami-event="field-note-open"
                data-umami-event-note={n.id}
                class="group relative block overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)]/60 p-6 transition-all duration-300 hover:border-[var(--color-line-bright)] hover:bg-[var(--color-surface)] sm:p-7"
              >
                <span
                  class="absolute inset-y-0 left-0 w-px transition-all duration-300 group-hover:w-[3px]"
                  style={`background:${n.data.accent}`}
                />
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <time
                    datetime={n.data.date.toISOString()}
                    class="font-mono text-[11px]"
                    style={`color:${n.data.accent}`}
                  >
                    {fmt.format(n.data.date)}
                  </time>
                  <h3 class="text-xl font-semibold tracking-tight text-[var(--color-ink)]">
                    {n.data.title}
                  </h3>
                  <span class="font-mono text-[10px] text-[var(--color-ink-faint)]">
                    {n.data.series}
                    {n.data.stage && ` · ${n.data.stage}`}
                  </span>
                </div>

                <p class="mt-1.5 font-mono text-[11px] text-[var(--color-ink-faint)]">
                  {n.data.subtitle}
                </p>
                <p class="mt-4 max-w-2xl leading-relaxed text-[var(--color-ink-dim)]">
                  {n.data.summary}
                </p>

                <div class="mt-5 flex flex-wrap items-center gap-1.5">
                  {n.data.tags.map((t) => (
                    <span class="rounded border border-[var(--color-line)] bg-[var(--color-base)] px-2 py-1 font-mono text-[10px] text-[var(--color-ink-faint)]">
                      {t}
                    </span>
                  ))}
                </div>

                <span class="mt-5 inline-flex items-center gap-2 font-mono text-[11px] text-[var(--color-ink-dim)] transition-colors group-hover:text-[var(--color-ink)]">
                  Read the note
                  <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
