---
interface Props {
  caption: string;
  label: string;
}
const { caption, label } = Astro.props;
---

<figure class="reveal my-10 -mx-2 sm:mx-0">
  <div
    class="overflow-x-auto rounded-xl border border-[var(--color-line)] bg-[var(--color-void)]/70 backdrop-blur-sm"
  >
    <div class="flex items-center gap-2 border-b border-[var(--color-line)] px-4 py-2.5">
      <span class="h-2 w-2 rounded-full bg-[var(--color-line-bright)]"></span>
      <span class="h-2 w-2 rounded-full bg-[var(--color-line-bright)]"></span>
      <span class="h-2 w-2 rounded-full bg-[var(--color-line-bright)]"></span>
      <span class="ml-2 font-mono text-[10px] tracking-[0.16em] text-[var(--color-ink-faint)] uppercase">
        {label}
      </span>
    </div>
    <div class="min-w-[680px] p-5 sm:min-w-0">
      <slot />
    </div>
  </div>
  <figcaption class="mt-3 font-mono text-[11px] leading-relaxed text-[var(--color-ink-faint)]">
    {caption}
  </figcaption>
</figure>
