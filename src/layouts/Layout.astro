---
import '../styles/global.css';
import { UMAMI_WEBSITE_ID, UMAMI_SRC, UMAMI_DOMAINS } from '../analytics';

interface Props {
  title?: string;
  description?: string;
  /** Slug of a generated card in /og. Falls back to the site-wide one. */
  ogImage?: string;
  /** Person schema belongs on the home page only, so search engines see one canonical claim. */
  person?: boolean;
}

const {
  title = 'Mahadi Hasan — Lead Software Engineer',
  description = 'Lead Software Engineer building event-driven systems for telecom billing, sales distribution and fintech. Eight years of Java, Spring Boot, Kafka and Kubernetes.',
  ogImage = 'default',
  person = false,
} = Astro.props;

// Absolute, because Open Graph consumers do not resolve relative URLs and a canonical
// link has to be unambiguous about which host is authoritative.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(`/og/${ogImage}.png`, Astro.site).href;

/**
 * Structured data. This is the difference between a search result that is a blue link and
 * one a person recognises: it tells Google that this page is *about a person*, which name,
 * which employer, and which other profiles are the same individual. The sameAs links are
 * what let it connect this site to the LinkedIn and GitHub profiles rather than treating
 * three unrelated pages that happen to share a name.
 */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mahadi Hasan',
  alternateName: 'Mahadi Hasan Parash',
  jobTitle: 'Lead Software Engineer',
  url: Astro.site?.href,
  image: ogImageUrl,
  worksFor: { '@type': 'Organization', name: 'Robi Axiata PLC' },
  address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Jashore University of Science and Technology',
  },
  knowsAbout: [
    'Java', 'Spring Boot', 'Apache Kafka', 'Kubernetes', 'Event-driven architecture',
    'Distributed systems', 'Telecom billing', 'Financial services', 'API security',
    'Model Context Protocol', 'AI agent security',
  ],
  sameAs: [
    'https://www.linkedin.com/in/mahadihasan-parash/',
    'https://github.com/AbuUsamaIbrahim',
  ],
};

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/notes/', label: 'Notes' },
  { href: '/#approach', label: 'Approach' },
  { href: '/#stack', label: 'Stack' },
  { href: '/cv', label: 'CV' },
  { href: '/#contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e14" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={person ? 'profile' : 'article'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Mahadi Hasan" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {person && (
      <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    )}

    {/* Cookieless analytics. `is:inline` because Astro would otherwise try to take this
        into its own bundle and drop the data-* attributes the script reads its own
        configuration from. Empty ID means no tag, which is the point. */}
    {UMAMI_WEBSITE_ID && (
      <script
        is:inline
        defer
        src={UMAMI_SRC}
        data-website-id={UMAMI_WEBSITE_ID}
        data-domains={UMAMI_DOMAINS}
      />
    )}
  </head>

  <body class="relative">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-[var(--color-raised)] focus:px-3 focus:py-2 focus:text-sm"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-[var(--color-line)]/70 bg-[var(--color-base)]/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3.5" aria-label="Main">
        <a href="/" class="group flex items-center gap-2.5">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-flow)] opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-flow)]"></span>
          </span>
          <span class="font-mono text-[13px] tracking-tight text-[var(--color-ink)]">
            mahadi<span class="text-[var(--color-ink-faint)]">.hasan</span>
          </span>
        </a>
        <ul class="flex items-center gap-1 sm:gap-2">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="rounded px-2.5 py-1.5 font-mono text-[12px] text-[var(--color-ink-dim)] transition-colors hover:bg-[var(--color-raised)] hover:text-[var(--color-ink)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 mt-24 border-t border-[var(--color-line)]">
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-5 py-10 sm:flex-row sm:items-center sm:justify-between">
        {/* The claim has to follow the code. With no website ID there is genuinely
            nothing loaded from anywhere else; with one, saying "no external requests"
            would be a lie told in the footer of a site about being precise. */}
        <p class="font-mono text-[11px] text-[var(--color-ink-faint)]">
          {UMAMI_WEBSITE_ID
            ? 'Built with Astro. Cookieless analytics — no cookies, no personal data.'
            : 'Built with Astro. No trackers, no cookies, no external requests.'}
        </p>
        <p class="font-mono text-[11px] text-[var(--color-ink-faint)]">
          Dhaka, Bangladesh
        </p>
      </div>
    </footer>

    <script>
      const items = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry, i) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).style.setProperty('--reveal-delay', `${Math.min(i, 5) * 70}ms`);
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
